Support the CGAL >= 6.1 Constrained_triangulation_plus_2 subconstraint API.

In CGAL 6.0.1 the Subconstraint_iterator dereferenced to a nested pair, so the
binding read the two vertex handles as `i.first.first` / `i.first.second`. In
CGAL >= 6.1 the iterator dereferences directly to
`std::pair<Vertex_handle, Vertex_handle>`, so the handles are `i.first` /
`i.second`.

diff --git a/SWIG_CGAL/Triangulation_2/Constrained_triangulation_plus_2.h b/SWIG_CGAL/Triangulation_2/Constrained_triangulation_plus_2.h
--- a/SWIG_CGAL/Triangulation_2/Constrained_triangulation_plus_2.h
+++ b/SWIG_CGAL/Triangulation_2/Constrained_triangulation_plus_2.h
@@ -21,7 +21,7 @@ struct Iterator_helper<std::pair<SWIG_Triangulation_2::CGAL_Vertex_handle<Triang

   template <class T1, class T2>
   static std::pair<Vertex_handle,Vertex_handle> convert(const std::pair<T1,T2>& i){
-    return std::pair<Vertex_handle,Vertex_handle>(Vertex_handle(i.first.first),Vertex_handle(i.first.second));
+    return std::pair<Vertex_handle,Vertex_handle>(Vertex_handle(i.first),Vertex_handle(i.second));
   }

   static std::pair<Vertex_handle,Vertex_handle> convert(const typename Triangulation::Constraint_id& i){
